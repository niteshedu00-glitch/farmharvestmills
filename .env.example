# Copy this file to .env for local development (or set these as real
# environment variables in your hosting provider's dashboard for production).

# --- Core ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production only ---
# DEBUG=False
# ALLOWED_HOSTS=farmharvestmills.in,www.farmharvestmills.in,your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://farmharvestmills.in,https://your-app.onrender.com

# --- Database ---
# Leave blank locally to use SQLite automatically.
# In production, Render/Railway provide this connection string for you.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Site info ---
SITE_NAME=Farm Harvest Mills
SITE_TAGLINE=Harvesting Purity, Milling Quality.
CONTACT_EMAIL=info@farmharvestmills.in
CONTACT_PHONE=+91-00000-00000
CONTACT_ADDRESS=Your Business Address, India

# --- Email (optional — leave blank to just print emails to console) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=info@farmharvestmills.in
ADMIN_NOTIFY_EMAIL=
